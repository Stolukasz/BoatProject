<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/BoatHUD.uss?fileID=7433441132597879392&amp;guid=96ffade0fddce2941b5b613b6353cdb3&amp;type=3#BoatHUD"/>
    <ui:VisualElement name="hud-container" style="flex-grow: 1; background-color: rgba(16, 44, 58, 0); border-top-width: 16px; border-left-width: 16px; border-bottom-width: 16px; border-right-width: 16px; color: rgb(195, 195, 195); -unity-font-style: bold; width: 431px; position: absolute; top: auto; left: 0; justify-content: flex-start; align-self: flex-end; align-content: center; align-items: flex-start; background-image: none; bottom: 0; right: auto;">
        <ui:VisualElement name="rotation_container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI.png?fileID=-533955555&amp;guid=80d8f9e3c7c4b7c4e935001316a53a36&amp;type=3#UI_7&quot;); width: 308px; bottom: auto;">
            <ui:Label text="SAIL ROTATION: 0°" name="sail-rotation-label" style="height: 65px; width: 306px; -unity-text-align: middle-left; color: rgb(66, 34, 9); -unity-font-style: bold; text-overflow: clip; text-shadow: 0 0 0 rgba(0, 0, 0, 0); padding-left: 82px; font-size: 18px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="opening-container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI.png?fileID=-1818537391&amp;guid=80d8f9e3c7c4b7c4e935001316a53a36&amp;type=3#UI_0&quot;); width: 308px;">
            <ui:Label text="SAIL OPENING 100%" name="sail-opening-label" style="height: 65px; width: 233px; -unity-text-align: middle-left; color: rgb(66, 34, 9); margin-left: 82px; font-size: 18px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Tutorial" style="flex-grow: 1; position: absolute; top: 20%; left: 20%; right: 20%; bottom: 20%; align-content: center; background-color: rgba(0, 0, 0, 0.961); align-self: center; align-items: center; justify-content: center; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-top-right-radius: 12px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149);">
        <ui:Button text="Close" name="CloseTutorial" style="position: absolute; top: auto; left: auto; width: 300px; bottom: 10%; background-image: none; background-color: rgba(192, 192, 192, 0.467); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; text-overflow: clip; -unity-font-style: bold; height: 36px; right: auto; max-width: 50%; max-height: 10%; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-right-radius: 5px; border-left-color: rgb(176, 176, 176); border-right-color: rgb(176, 176, 176); border-top-color: rgb(176, 176, 176); border-bottom-color: rgb(176, 176, 176); font-size: 24px;"/>
        <ui:Label text="Boat Controls&#10;&#10;W or ↑ – Raise the sails.&#10;&#10;S or ↓ – Lower the sails.&#10;&#10;A or ← – Turn the sail left.&#10;&#10;D or → – Turn the sail right." style="position: absolute; width: 100%; height: 60%; align-content: center; -unity-text-align: upper-center; top: 15%; font-size: 24px; -unity-font-style: bold; align-items: center; bottom: auto; left: auto; right: auto; align-self: center; justify-content: center; white-space: nowrap; color: rgb(168, 168, 168);"/>
    </ui:VisualElement>
</ui:UXML>
